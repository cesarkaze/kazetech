---
import { ui, defaultLang } from '../i18n/ui';

// Detección segura del idioma según la URL actual
const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith('/en/') || pathname === '/en';
const currentLang = isEnglish ? 'en' : 'es';

const t = ui[currentLang as keyof typeof ui] || ui[defaultLang as keyof typeof ui];

const langInfo = {
  es: { name: 'Español', code: 'ES', flag: 'https://flagcdn.com/w40/es.png' },
  en: { name: 'English', code: 'EN', flag: 'https://flagcdn.com/w40/us.png' }
};
const currentLangData = langInfo[currentLang];

// Calcula la URL correspondiente para cambiar de idioma manteniendo la página actual
const esTargetUrl = isEnglish ? (pathname.replace(/^\/en/, '') || '/') : pathname;
const enTargetUrl = isEnglish ? pathname : (`/en${pathname.startsWith('/') ? pathname : '/' + pathname}`).replace('//', '/');
---

<header class="sticky top-0 z-50 border-b border-neutral-800 bg-neutral-950/90 backdrop-blur-md">
  <div class="w-full px-6 md:px-12 2xl:px-20 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href={currentLang === 'es' ? '/' : '/en/'} class="flex items-center gap-3 group">
      <div class="flex items-center justify-center h-8 w-8 rounded-lg bg-gradient-to-br from-sky-400 to-sky-600 shadow-[0_0_12px_rgba(2,132,199,0.4)] transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(2,132,199,0.6)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-neutral-950">
          <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
        </svg>
      </div>
      <span class="font-black text-xl sm:text-2xl tracking-tight text-white uppercase select-none">
        Kaze<span class="text-sky-500">Tech</span>
      </span>
    </a>

    <!-- Navegación -->
    <nav class="hidden sm:flex items-center gap-8 text-sm font-semibold text-neutral-400">
      <a href={currentLang === 'es' ? '/' : '/en/'} class="hover:text-sky-400 transition-colors">{t['nav.home']}</a>
      <a href={currentLang === 'es' ? '/#comparativa' : '/en/#comparativa'} class="hover:text-sky-400 transition-colors">{t['nav.compare']}</a>
      <a href={currentLang === 'es' ? '/#analisis' : '/en/#reviews'} class="hover:text-sky-400 transition-colors">{t['nav.reviews']}</a>
      
      <!-- Menú Desplegable de Idiomas -->
      <div class="relative group ml-4 pl-5 border-l border-neutral-800">
        
        <button class="flex items-center gap-2.5 py-2 text-neutral-300 hover:text-white transition-colors cursor-pointer">
          <img src={currentLangData.flag} alt={currentLangData.code} class="w-5 h-auto rounded-[2px] shadow-sm opacity-90" />
          <span class="uppercase text-xs font-bold tracking-wider">{currentLangData.code}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral-500 group-hover:text-sky-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute right-0 top-full mt-1.5 w-40 rounded-xl border border-neutral-800 bg-neutral-950/95 backdrop-blur-md shadow-xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50 overflow-hidden py-1.5">
          
          <!-- Opción Español -->
          <a href={esTargetUrl} class={`flex items-center justify-between px-4 py-2.5 hover:bg-neutral-800/80 transition-colors ${currentLang === 'es' ? 'text-sky-400 bg-sky-900/10 font-bold' : 'text-neutral-300'}`}>
            <div class="flex items-center gap-3">
              <img src={langInfo.es.flag} alt="ES" class="w-5 h-auto rounded-[2px] opacity-90" />
              <span class="text-xs font-bold">Español</span>
            </div>
            {currentLang === 'es' && <span class="text-sky-400 text-sm font-bold">✓</span>}
          </a>
          
          <!-- Opción Inglés -->
          <a href={enTargetUrl} class={`flex items-center justify-between px-4 py-2.5 hover:bg-neutral-800/80 transition-colors ${currentLang === 'en' ? 'text-sky-400 bg-sky-900/10 font-bold' : 'text-neutral-300'}`}>
            <div class="flex items-center gap-3">
              <img src={langInfo.en.flag} alt="EN" class="w-5 h-auto rounded-[2px] opacity-90" />
              <span class="text-xs font-bold">English</span>
            </div>
            {currentLang === 'en' && <span class="text-sky-400 text-sm font-bold">✓</span>}
          </a>
          
        </div>

      </div>
    </nav>
  </div>
</header>