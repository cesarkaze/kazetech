---
interface Props {
  product: {
    name: string;
    badge?: string;
    rating: string;
    pros?: string[];
    cons?: string[];
    affiliateUrl?: string;
  };
  lang?: 'es' | 'en';
}

const { product, lang = 'es' } = Astro.props;

const labels = {
  es: {
    verdict: "Veredicto del Laboratorio",
    pros: "Puntos Fuertes",
    cons: "A Considerar",
    buyBtn: "Ver Oferta en Amazon",
    guarantee: "Precios y disponibilidad verificados en tiempo real"
  },
  en: {
    verdict: "Lab Verdict",
    pros: "Key Strengths",
    cons: "Drawbacks",
    buyBtn: "Check Price on Amazon",
    guarantee: "Prices and availability verified in real time"
  }
}[lang];
---

<div class="my-10 rounded-2xl border border-sky-500/30 bg-gradient-to-b from-neutral-900/90 via-neutral-900/60 to-neutral-950 p-6 md:p-8 shadow-[0_0_40px_rgba(2,132,199,0.12)] relative overflow-hidden not-prose">
  
  <!-- Luz de fondo decorativa -->
  <div class="absolute -top-24 -right-24 w-60 h-60 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header de la caja: Nombre, Badge y Rating -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-800/80">
    <div>
      <span class="text-[10px] font-extrabold uppercase tracking-widest text-sky-400 bg-sky-950/60 px-2.5 py-1 rounded border border-sky-800/40">
        {labels.verdict}
      </span>
      <h3 class="text-2xl font-black text-white mt-2 tracking-tight">
        {product.name}
      </h3>
      {product.badge && (
        <span class="inline-block mt-1 text-xs font-bold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20">
          ★ {product.badge}
        </span>
      )}
    </div>

    <!-- Puntuación Destacada -->
   <div class="flex items-center sm:flex-col sm:items-end justify-between bg-neutral-950/80 sm:bg-transparent p-3 sm:p-0 rounded-xl border sm:border-0 border-neutral-800">
      <div class="text-3xl sm:text-4xl font-black text-white flex items-center gap-1.5">
        <span class="text-amber-400 text-2xl sm:text-3xl">★</span>
        <span>{product.rating}</span>
        <span class="text-xs text-neutral-500 font-semibold self-end mb-1">/ 5.0</span>
      </div>
      <span class="text-[11px] text-neutral-400 font-medium hidden sm:inline">Puntuación de Rendimiento</span>
    </div>
  </div>

  <!-- Pros & Cons Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
    
    <!-- Pros -->
    {product.pros && product.pros.length > 0 && (
      <div class="bg-neutral-950/50 rounded-xl p-4 border border-emerald-500/20">
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-emerald-400 flex items-center gap-2 mb-3">
          <span class="flex items-center justify-center w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px]">✓</span>
          {labels.pros}
        </h4>
        <ul class="space-y-2 text-xs text-neutral-300">
          {product.pros.map((pro: string) => (
            <li class="flex items-start gap-2 leading-relaxed">
              <span class="text-emerald-400 font-bold mt-0.5">•</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Cons -->
    {product.cons && product.cons.length > 0 && (
      <div class="bg-neutral-950/50 rounded-xl p-4 border border-rose-500/20">
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-rose-400 flex items-center gap-2 mb-3">
          <span class="flex items-center justify-center w-4 h-4 rounded-full bg-rose-500/20 text-rose-400 text-[10px]">✕</span>
          {labels.cons}
        </h4>
        <ul class="space-y-2 text-xs text-neutral-300">
          {product.cons.map((con: string) => (
            <li class="flex items-start gap-2 leading-relaxed">
              <span class="text-rose-400 font-bold mt-0.5">•</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

  </div>

  <!-- Botón de Conversión Amazon / CTA -->
  {product.affiliateUrl && (
    <div class="pt-4 border-t border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-[11px] text-neutral-400 text-center sm:text-left flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        {labels.guarantee}
      </span>
      
      <a 
        href={product.affiliateUrl} 
        target="_blank" 
        rel="nofollow sponsored noopener" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-neutral-950 font-black text-sm px-7 py-3 rounded-xl transition-all shadow-[0_0_20px_rgba(245,158,11,0.25)] hover:shadow-[0_0_30px_rgba(245,158,11,0.45)] hover:scale-[1.02] active:scale-95"
      >
        <span>{labels.buyBtn}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  )}

</div>