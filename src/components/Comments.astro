---
// src/components/Comments.astro
---

<div class="mt-16 pt-10 border-t border-neutral-800">
  <div class="mb-6">
    <span class="text-xs font-bold uppercase tracking-wider text-sky-500">Comunidad</span>
    <h3 class="text-2xl font-black text-white tracking-tight">Preguntas y Debate</h3>
    <p class="text-xs text-neutral-400 mt-1">Inicia sesión con GitHub para dejar tu duda sobre este hardware de forma segura.</p>
  </div>

  <!-- Script oficial generado por Giscus -->
  <script src="https://giscus.app/client.js"
        data-repo="cesarkaze/kazetech-discussions"
        data-repo-id="[El ID que te dio giscus]"
        data-category="General"
        data-category-id="[El ID de categoría que te dio giscus]"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="dark"
        data-lang="es"
        crossorigin="anonymous"
        async>
  </script>
</div>